#!/usr/bin/env bash
# Canonical sync script. Called by:
#   - .github/workflows/sync.yml (cron + repository_dispatch[sync])
#
# Takes the path to a checkout of fontist-archive-private. The caller is
# responsible for providing it — sync.yml uses actions/checkout, which
# handles authentication and token masking. This script deliberately does
# NOT clone: an earlier version fell back to an unauthenticated HTTPS clone
# of a private repo, which failed with
#   fatal: could not read Username for 'https://github.com'
# on every scheduled run for a month while CI stayed green.
#
# Local use:
#   ./bin/sync-from-private ~/fontist/fontist-archive-private
#
# macos handling per coverage-architecture.md data-separation table:
#   coverage + details: ALL public (copy macos/)
#   woff:               skip macos/ (proprietary licenses)
#
# See TODO.archives/06-archive-public-sync-unification.md.

set -euo pipefail

if [ $# -lt 1 ]; then
  echo "usage: $0 <path-to-fontist-archive-private-checkout>" >&2
  exit 2
fi

SRC="$1"

# Fail loudly on a missing or wrong-shaped source. Every artifact below is
# required; treating any of them as optional is what let an empty archive
# ship to production unnoticed.
for required in coverage details woff fonts.json font-metadata.json; do
  if [ ! -e "$SRC/$required" ]; then
    echo "error: $SRC/$required not found — is '$SRC' a fontist-archive-private checkout?" >&2
    exit 1
  fi
done

echo "Source: $SRC"

echo "Syncing coverage (ALL including macos/)..."
rm -rf coverage
mkdir -p coverage
cp -r "$SRC/coverage/." coverage/

echo "Syncing details (ALL including macos/)..."
rm -rf details
mkdir -p details
cp -r "$SRC/details/." details/

echo "Syncing woff (OPEN LICENSES ONLY — skip macos/)..."
# Also remove the legacy flat `fonts/` tree: 2,165 stale per-family woff files
# from the June snapshot that nothing reads — the site fetches
# woff/{formula_slug}/{PSName}.woff exclusively (font-metadata.json's woff_file;
# TODO.archives/16). Deleting it here means the next sync commits the removal,
# staged by `git add -A` in the workflow.
rm -rf woff fonts
mkdir -p woff
for d in "$SRC/woff"/*; do
  [ -e "$d" ] || continue
  base=$(basename "$d")
  if [ "$base" != "macos" ]; then
    cp -r "$d" "woff/"
  fi
done

echo "Syncing registries..."
cp "$SRC/fonts.json" .
cp "$SRC/font-metadata.json" .

echo ""
echo "Counts:"
printf "  coverage: %s files\n" "$(find coverage -name '*.json' 2>/dev/null | wc -l | tr -d ' ')"
printf "  details:  %s files\n" "$(find details -name '*.json' 2>/dev/null | wc -l | tr -d ' ')"
printf "  woff:     %s files\n" "$(find woff -name '*.woff' 2>/dev/null | wc -l | tr -d ' ')"
